<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grau_hintergrund"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="@string/app_name"
            android:textColor="@color/gruen_akzent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/feldAufgabe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/aufgabe_hint"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:textColor="@color/text_hell"
            android:textColorHint="@color/text_gedimmt" />

        <EditText
            android:id="@+id/feldVerzeichnis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/verzeichnis_hint"
            android:inputType="text"
            android:textColor="@color/text_hell"
            android:textColorHint="@color/text_gedimmt" />

        <EditText
            android:id="@+id/feldOllama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/ollama_hint"
            android:inputType="textUri"
            android:textColor="@color/text_hell"
            android:textColorHint="@color/text_gedimmt" />

        <EditText
            android:id="@+id/feldModell"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/modell_hint"
            android:inputType="text"
            android:textColor="@color/text_hell"
            android:textColorHint="@color/text_gedimmt" />

        <EditText
            android:id="@+id/feldIterationen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/iterationen_hint"
            android:inputType="number"
            android:textColor="@color/text_hell"
            android:textColorHint="@color/text_gedimmt" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/knopfStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/start" />

            <Button
                android:id="@+id/knopfOllama"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ollama_pruefen" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/protokoll"
            android:textColor="@color/text_gedimmt" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listeProtokoll"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:background="@color/grau_karte" />
    </LinearLayout>
</ScrollView>
